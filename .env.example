# Copy to .env and fill in your PayPal Sandbox app credentials.
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# NEVER commit a real .env file.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: enables an LLM-written plan explanation (falls back to a
# deterministic explanation when unset).
GEMINI_API_KEY=
